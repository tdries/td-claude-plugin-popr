#!/bin/bash
# POPR · clickable macOS notifications for Claude Code sessions
#
# Hook modes (wired by `popr install` or by hooks/hooks.json as a plugin):
#   popr stop        Claude finished a turn
#   popr attention   Claude wants a permission or your input
#   popr error       The turn ended on an API error
#   popr clear       You sent a new prompt, drop this session's stale banner
#
# By hand:
#   popr install [--force] [--quiet]   register the hooks in ~/.claude/settings.json
#   popr uninstall           remove them again
#   popr config              interactive settings
#   popr test                fire a test notification
#   popr doctor              health check
#   popr version | help
#
# Settings resolve POPR_<KEY> > CLAUDE_PLUGIN_OPTION_<KEY> > config file > default.
# See `popr help` for the keys.

set -u
VERSION="1.6.0"
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:${PATH:-}"

MODE="${1:-stop}"
LOG_FILE="${POPR_LOG:-$HOME/Library/Logs/popr.log}"
CONFIG_FILE="${POPR_CONFIG:-$HOME/.config/popr/config.json}"
CLAUDE_DIR="${POPR_CLAUDE_DIR:-$HOME/.claude}"
SETTINGS_FILE="$CLAUDE_DIR/settings.json"
DRY="${POPR_DRY_RUN:-}"

has() { command -v "$1" >/dev/null 2>&1; }
lower() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }
is_true() { case "$(lower "$1")" in 1 | true | yes | on) return 0 ;; esac; return 1; }

# ---------------------------------------------------------------- own location
# Resolve $0 through symlinks before deriving the package root. Homebrew and the
# curl installer both expose bin/popr as a symlink, and a naive dirname would
# land on /opt/homebrew, losing the bundled icon.
SELF="${BASH_SOURCE[0]:-$0}"
while [ -L "$SELF" ]; do
    self_dir="$(cd -P "$(dirname "$SELF")" && pwd)"
    SELF="$(readlink "$SELF")"
    case "$SELF" in /*) ;; *) SELF="$self_dir/$SELF" ;; esac
done
SCRIPT_PATH="$(cd -P "$(dirname "$SELF")" && pwd)/$(basename "$SELF")"
ROOT="${CLAUDE_PLUGIN_ROOT:-$(cd -P "$(dirname "$SELF")/.." && pwd)}"

# ---------------------------------------------------------------- settings
CONFIG_JSON=""
[ -f "$CONFIG_FILE" ] && CONFIG_JSON="$(cat "$CONFIG_FILE" 2>/dev/null)"

opt() {
    local key upper v
    key="$1"
    upper="$(printf '%s' "$key" | tr '[:lower:]' '[:upper:]')"
    v="$(printenv "POPR_$upper" 2>/dev/null || true)"
    [ -z "$v" ] && v="$(printenv "CLAUDE_PLUGIN_OPTION_$upper" 2>/dev/null || true)"
    if [ -z "$v" ] && [ -n "$CONFIG_JSON" ] && has jq; then
        # has($k) rather than `// empty`, which would swallow a stored `false`.
        v="$(printf '%s' "$CONFIG_JSON" |
            jq -r --arg k "$key" 'if has($k) and .[$k] != null then (.[$k]|tostring) else empty end' 2>/dev/null)"
    fi
    [ -z "$v" ] && v="$2"
    printf '%s' "$v"
}

log() {
    mkdir -p "$(dirname "$LOG_FILE")" 2>/dev/null || return 0
    if [ -f "$LOG_FILE" ] && [ "$(stat -f%z "$LOG_FILE" 2>/dev/null || echo 0)" -gt 262144 ]; then
        mv -f "$LOG_FILE" "$LOG_FILE.1" 2>/dev/null
    fi
    printf '%s [%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$MODE" "$*" >>"$LOG_FILE" 2>/dev/null
}

# Collapse to one line and strip leading characters terminal-notifier would
# misread. A message starting with "-" would otherwise be parsed as a flag.
clean() {
    local s
    s="$(printf '%s' "$1" | tr -s '[:space:]' ' ')"
    while :; do
        case "$s" in
            [[:space:]]* | '"'* | '('* | '['* | '{'* | -*) s="${s#?}" ;;
            *) break ;;
        esac
    done
    printf '%s' "$s"
}

# ---------------------------------------------------------------- hook input
INPUT="{}"
case "$MODE" in
    test | doctor | install | uninstall | config | version | help | -h | --help) ;;
    *) [ -t 0 ] || INPUT="$(cat)" ;;
esac
[ -n "$INPUT" ] || INPUT="{}"

jget() {
    has jq || return 0
    printf '%s' "$INPUT" | jq -r "($1)"' | select(type == "string" or type == "number")' 2>/dev/null | head -n 1
}

SESSION_ID="$(jget '.session_id')"
SESSION_ID="${SESSION_ID:-manual}"
CWD="$(jget '.cwd')"
TRANSCRIPT="$(jget '.transcript_path')"
PROJECT_DIR="${CLAUDE_PROJECT_DIR:-${CWD:-$PWD}}"
PROJECT_NAME="$(basename "$PROJECT_DIR")"
GROUP="popr-$SESSION_ID"

BRANCH=""
GITDIR="$PROJECT_DIR/.git"
if [ -f "$GITDIR" ]; then # a worktree: .git is a file pointing elsewhere
    GITDIR="$(sed -n 's/^gitdir: //p' "$GITDIR" 2>/dev/null)"
    case "$GITDIR" in /*) ;; *) GITDIR="$PROJECT_DIR/$GITDIR" ;; esac
fi
[ -f "$GITDIR/HEAD" ] && BRANCH="$(sed -n 's#^ref: refs/heads/##p' "$GITDIR/HEAD" 2>/dev/null)"
case "$GITDIR" in */.git/worktrees/*) PROJECT_NAME="$(basename "${GITDIR%%/.git/worktrees/*}")" ;; esac
LABEL="$PROJECT_NAME"
[ -n "$BRANCH" ] && LABEL="$PROJECT_NAME · $BRANCH"

# ---------------------------------------------------------------- host app
ENTRY="${CLAUDE_CODE_ENTRYPOINT:-}"
if [ -z "$ENTRY" ] && [ -n "$TRANSCRIPT" ] && [ -f "$TRANSCRIPT" ] && has jq; then
    ENTRY="$(head -n 30 "$TRANSCRIPT" | jq -Rr 'fromjson? | .entrypoint // empty' 2>/dev/null | head -n 1)"
fi

# Walk up the process tree until we hit something living inside a .app bundle.
find_host_app() {
    local forced pid comm i=0
    forced="$(opt app "")"
    if [ -n "$forced" ]; then
        case "$forced" in
            /*) printf '%s' "$forced" ;;
            *) printf '/Applications/%s.app' "${forced%.app}" ;;
        esac
        return 0
    fi
    case "$ENTRY" in *desktop*) printf '/Applications/Claude.app'; return 0 ;; esac
    pid=$$
    while [ -n "$pid" ] && [ "$pid" -gt 1 ] 2>/dev/null && [ "$i" -lt 30 ]; do
        comm="$(ps -o comm= -p "$pid" 2>/dev/null)"
        case "$comm" in
            *.app/*) printf '%s.app' "${comm%%.app/*}"; return 0 ;;
        esac
        pid="$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')"
        i=$((i + 1))
    done
    return 0
}

HOST_APP="$(find_host_app)"
[ -n "$HOST_APP" ] || HOST_APP="/Applications/Visual Studio Code.app"
APP_NAME="$(basename "$HOST_APP" .app)"
OPEN_TARGET="$HOST_APP"
[ -d "$HOST_APP" ] || OPEN_TARGET="$APP_NAME"

case "$APP_NAME" in
    "Visual Studio Code") WHERE="VS Code" ;;
    Claude) WHERE="Claude Desktop" ;;
    *) WHERE="$APP_NAME" ;;
esac
case "$APP_NAME" in
    *"Visual Studio Code"* | Code* | *Cursor* | *Windsurf* | *VSCodium* | *Kiro* | *Trae*) IS_EDITOR=1 ;;
    *) IS_EDITOR=0 ;;
esac

# For an editor, opening the project folder raises the window that already has
# it open. For anything else, just activate the app.
if [ "$IS_EDITOR" = 1 ] && [ -d "$PROJECT_DIR" ]; then
    CLICK_CMD="open -a $(printf '%q' "$OPEN_TARGET") $(printf '%q' "$PROJECT_DIR")"
else
    CLICK_CMD="open -a $(printf '%q' "$OPEN_TARGET")"
fi

APP_ICON=""
if [ -d "$HOST_APP" ] && has defaults; then
    icon_file="$(defaults read "$HOST_APP/Contents/Info" CFBundleIconFile 2>/dev/null)"
    if [ -n "$icon_file" ]; then
        case "$icon_file" in *.icns) ;; *) icon_file="$icon_file.icns" ;; esac
        [ -f "$HOST_APP/Contents/Resources/$icon_file" ] && APP_ICON="$HOST_APP/Contents/Resources/$icon_file"
    fi
fi

# The picture on the RIGHT of the banner, which is optional. The one on the LEFT
# is the app bundle's icon and macOS always draws it: hand it an empty icns and
# it substitutes a white square rather than nothing (tested on a bundle id it had
# never seen, so no cache was involved). So the left slot is the logo, and the
# right one defaults to empty rather than repeating the same mark twice.
pick_icon() {
    local o
    o="$(opt icon "")"
    case "$(lower "$o")" in
        none | off | false) return 0 ;;
        app) printf '%s' "$APP_ICON"; return 0 ;;
        "") [ -f "$ROOT/assets/custom.png" ] && printf '%s' "$ROOT/assets/custom.png"; return 0 ;;
        *) [ -f "$o" ] && printf '%s' "$o"; return 0 ;;
    esac
}
ICON="$(pick_icon)"

# ---------------------------------------------------------------- banners
# POPR draws its own banners rather than posting macOS notifications. macOS gives
# no control over a notification banner: fixed layout, an app-bundle icon that
# cannot be emptied, and nothing in it will animate. Ours is a window we own.
#
# One banner per session, stacked. Slots are claimed with mkdir, which is atomic,
# so two sessions finishing at the same moment cannot land on the same one.
BANNER_JS="$ROOT/assets/banner.js"
# Empty by default: the banner draws each project its own mark from the DNA.
# Point banner_icon at a PNG to use fixed artwork instead.
STATE_DIR="${POPR_STATE:-${TMPDIR:-/tmp}/popr-$(id -u)}"

slot_dir() { printf '%s/slot-%s' "$STATE_DIR" "$1"; }

# Drop slots whose banner process has gone, so a crash cannot leak one forever.
reap_slots() {
    local d pid
    for d in "$STATE_DIR"/slot-*; do
        [ -d "$d" ] || continue
        pid="$(cat "$d/pid" 2>/dev/null)"
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then continue; fi
        rm -rf "$d"
    done
}

# Take down this session's existing banner, so a session never stacks on itself.
drop_session_banner() {
    local d pid
    for d in "$STATE_DIR"/slot-*; do
        [ -d "$d" ] || continue
        [ "$(cat "$d/session" 2>/dev/null)" = "$SESSION_ID" ] || continue
        pid="$(cat "$d/pid" 2>/dev/null)"
        [ -n "$pid" ] && kill "$pid" 2>/dev/null
        rm -rf "$d"
    done
}

claim_slot() {
    local i
    mkdir -p "$STATE_DIR" 2>/dev/null
    reap_slots
    for i in 0 1 2 3 4 5 6 7; do
        if mkdir "$(slot_dir "$i")" 2>/dev/null; then printf '%s' "$i"; return 0; fi
    done
    printf '0'
}

# ---------------------------------------------------------------- notifier
# macOS takes a notification's icon and name from the bundle that posts it, and
# offers no API to override either (terminal-notifier dropped -appIcon and
# -sender for exactly this reason). So POPR posts through its own copy of
# terminal-notifier's bundle, restamped with POPR's identity and icon. It is
# built on the user's own machine at install time, so it carries no quarantine
# flag and needs no Developer ID. Falls back to plain terminal-notifier.
BUNDLE="${POPR_BUNDLE:-$HOME/Applications/POPR.app}"
BUNDLE_ID="be.tdries.popr"
LSREGISTER="/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister"

NOTIFIER=""
if [ -x "$BUNDLE/Contents/MacOS/terminal-notifier" ]; then
    NOTIFIER="$BUNDLE/Contents/MacOS/terminal-notifier"
    BRANDED=1
elif has terminal-notifier; then
    NOTIFIER="$(command -v terminal-notifier)"
    BRANDED=0
else
    BRANDED=0
fi

# ---------------------------------------------------------------- output
is_focused() {
    has lsappinfo || return 1
    local front
    front="$(lsappinfo info -only bundlepath "$(lsappinfo front 2>/dev/null)" 2>/dev/null | awk -F'"' '{print $4}')"
    [ -n "$front" ] && [ "$front" = "$HOST_APP" ]
}

# POPR ships its own sounds: three swells sharing one timbre, so they read as
# one instrument and you can tell them apart without looking. Falls back to the
# macOS system sound if the bundled file is missing.
snd() { # name macos-fallback
    if [ -f "$ROOT/assets/$1.wav" ]; then printf '%s' "$ROOT/assets/$1.wav"; else printf '%s' "$2"; fi
}

play_sound() {
    [ -n "$DRY" ] && return 0
    local s="$1" f
    case "$(lower "$s")" in "" | none | off | false | 0) return 0 ;; esac
    case "$s" in
        /*) f="$s" ;;
        *) f="/System/Library/Sounds/$s.aiff" ;;
    esac
    [ -f "$f" ] || f="/System/Library/Sounds/Glass.aiff"
    has afplay && (afplay -v "$(opt volume 1)" "$f" >/dev/null 2>&1 &)
    return 0
}

# macOS draws notification banners itself and will not animate anything inside
# one: the icon comes from the app bundle as a static .icns, and an animated GIF
# passed as the content image is shown as its first frame and nothing more (we
# tested it). The only way to get motion is to stop asking the notification
# system for it, so POPR draws its own window: borderless, transparent, click
# through, on top, gone in about a second.
# Arm the confetti for the banner about to be drawn. The banner fires it itself,
# centred on its own logo, because only it knows where that ended up. The shape
# is seeded from the project slug, so every project has its own burst.
burst_arm() {
    is_true "$(opt confetti true)" || return 0
    BURST_DNA="$PROJECT_NAME"
}

speak() {
    [ -n "$DRY" ] && return 0
    is_true "$(opt speak false)" || return 0
    has say && (say "$1" >/dev/null 2>&1 &)
    return 0
}

BURST_DNA=""   # project slug, set by the caller when this event deserves confetti

notify() {
    local title="$1" subtitle="$2" message="$3"
    local style slot dir line
    style="$(opt banner_style pill)"
    # One line means only what matters: the mark, the project, the status. Which
    # app it happened in is what the click is for.
    line="$message"

    if [ -n "$DRY" ]; then
        printf 'NOTIFY\ttitle=%s\tsubtitle=%s\tmessage=%s\tgroup=%s\ticon=%s\tbranded=%s\tstyle=%s\tclick=%s\n' \
            "$title" "$subtitle" "$message" "$GROUP" "${ICON:-}" "$BRANDED" "$style" "$CLICK_CMD"
        return 0
    fi

    # Our own banner, unless it is unavailable or explicitly turned off.
    if is_true "$(opt banner true)" && [ -f "$BANNER_JS" ] && has osascript; then
        drop_session_banner
        slot="$(claim_slot)"
        dir="$(slot_dir "$slot")"
        printf '%s' "$SESSION_ID" >"$dir/session" 2>/dev/null
        # Fully detached, stdio and all. Redirecting only osascript is not
        # enough: the subshell still holds the parent's stdout, so the calling
        # shell waits for it, and a banner that lives until you click it would
        # hang `popr install` and, far worse, the hook itself.
        (
            # Capture the result rather than discarding it. The banner returns
            # 'clicked' or 'timeout' when it worked, its own error string when it
            # threw, and NOTHING AT ALL when the JXA bridge kills the process
            # outright, which is how both of this project's worst bugs presented.
            # A silent failure here would mean no notification at all, so treat
            # anything unexpected as a failure and fall back.
            outcome="$(osascript -l JavaScript "$BANNER_JS" "$title" "$line" \
                "$(opt banner_icon "")" "$slot" "$style" "$CLICK_CMD" \
                "$(opt banner_seconds 900)" "$(opt font "")" \
                "$BURST_DNA" "$(opt confetti_size 90)" 2>&1)"
            case "$outcome" in
                clicked | timeout) ;;
                *)
                    log "banner failed (${outcome:-no output at all}), falling back"
                    if [ -n "$NOTIFIER" ]; then
                        "$NOTIFIER" -title "$title" -subtitle "$subtitle" -message "$message" \
                            -group "$GROUP" -execute "$CLICK_CMD" >/dev/null 2>&1
                    else
                        osascript - "$title" "$subtitle" "$message" >/dev/null 2>&1 <<'OSA'
on run argv
  display notification (item 3 of argv) with title (item 1 of argv) subtitle (item 2 of argv)
end run
OSA
                    fi
                    ;;
            esac
            rm -rf "$dir"
        ) </dev/null >/dev/null 2>&1 &
        printf '%s' "$!" >"$dir/pid" 2>/dev/null
        # The native notification is off by default: POPR's banner replaces it.
        is_true "$(opt native false)" || return 0
    fi
    if [ -n "$NOTIFIER" ]; then
        local args=(-title "$title" -subtitle "$subtitle" -message "$message" -group "$GROUP" -execute "$CLICK_CMD")
        [ -n "$ICON" ] && args+=(-contentImage "$ICON")
        "$NOTIFIER" "${args[@]}" >/dev/null 2>&1
    else
        osascript - "$title" "$subtitle" "$message" >/dev/null 2>&1 <<'OSA'
on run argv
  display notification (item 3 of argv) with title (item 1 of argv) subtitle (item 2 of argv)
end run
OSA
    fi
}

# The last thing Claude said, from the hook payload if present, else the tail of
# the transcript. Markdown stripped, capped at 140 chars.
summary() {
    has jq || return 0
    local s=""
    s="$(printf '%s' "$INPUT" | jq -r '.last_assistant_message | if type == "string" then . else empty end' 2>/dev/null)"
    if [ -z "$s" ] && [ -n "$TRANSCRIPT" ] && [ -f "$TRANSCRIPT" ]; then
        s="$(tail -n 400 "$TRANSCRIPT" | jq -Rrn '[inputs | fromjson? | select(.type == "assistant") | .message.content | if type == "array" then .[] else empty end | select(.type == "text") | .text] | last // empty' 2>/dev/null)"
    fi
    [ -n "$s" ] || return 0
    s="$(clean "$(printf '%s' "$s" | tr -d '`*#>')")"
    # A status, not an excerpt: first sentence, at most seven words. The banner
    # gives one line and nothing is allowed to trail off into an ellipsis, so
    # this shortens by summarising rather than by cutting.
    printf '%s' "$s" | jq -Rrs --argjson n "$(opt summary_words 7)" '
      (split(".") | .[0] | split(" ") | map(select(length > 0)))
      | .[0:$n] | join(" ")' 2>/dev/null
}

# ---------------------------------------------------------------- hook wiring
# Any hook whose command runs bin/popr or bin/butlr. Butlr is POPR's predecessor;
# leaving its hooks in place would double every banner.
HOOK_PATTERN='/bin/(popr|butlr)'

plugin_install_found() {
    local d
    for d in "$CLAUDE_DIR"/plugins/*/popr "$CLAUDE_DIR"/plugins/*/*/popr \
        "$CLAUDE_DIR"/plugins/marketplaces/*/popr "$CLAUDE_DIR"/skills/popr; do
        [ -d "$d" ] && [ "$d" != "$ROOT" ] && { printf '%s' "$d"; return 0; }
    done
    return 1
}

# Where Homebrew (or anything else) keeps terminal-notifier's app bundle.
source_bundle() {
    local tn dir
    has terminal-notifier || return 1
    tn="$(command -v terminal-notifier)"
    while [ -L "$tn" ]; do
        dir="$(cd -P "$(dirname "$tn")" && pwd)"
        tn="$(readlink "$tn")"
        case "$tn" in /*) ;; *) tn="$dir/$tn" ;; esac
    done
    dir="$(cd -P "$(dirname "$tn")/.." && pwd)/terminal-notifier.app"
    [ -d "$dir" ] || return 1
    printf '%s' "$dir"
}

pset() { # plist key value  · -replace refuses a key that is not there yet
    plutil -remove "$2" "$1" >/dev/null 2>&1
    plutil -insert "$2" -string "$3" "$1" >/dev/null 2>&1
}

build_bundle() {
    local src plist
    src="$(source_bundle)" || return 1
    [ -f "$ROOT/assets/POPR.icns" ] || { echo "popr: assets/POPR.icns is missing" >&2; return 1; }

    rm -rf "$BUNDLE"
    mkdir -p "$(dirname "$BUNDLE")"
    cp -R "$src" "$BUNDLE"
    rm -rf "$BUNDLE/Contents/_CodeSignature"
    find "$BUNDLE/Contents/Resources" -maxdepth 1 -name '*.icns' -delete
    cp "$ROOT/assets/POPR.icns" "$BUNDLE/Contents/Resources/POPR.icns"

    plist="$BUNDLE/Contents/Info.plist"
    pset "$plist" CFBundleIdentifier "$BUNDLE_ID"
    pset "$plist" CFBundleName POPR
    pset "$plist" CFBundleDisplayName POPR
    pset "$plist" CFBundleIconFile POPR
    # asks macOS to default this app to persistent Alerts rather than Banners
    pset "$plist" NSUserNotificationAlertStyle alert
    # so doctor can tell when a terminal-notifier upgrade left the copy behind
    pset "$plist" POPRBuiltFrom "$("$src/Contents/MacOS/terminal-notifier" -version 2>/dev/null | head -n 1)"

    # The source bundle is itself ad-hoc signed, so re-signing ad-hoc after our
    # edits keeps it valid without any certificate.
    codesign --force --sign - "$BUNDLE" >/dev/null 2>&1 || {
        echo "popr: could not sign $BUNDLE" >&2
        return 1
    }
    [ -x "$LSREGISTER" ] && "$LSREGISTER" -f "$BUNDLE" >/dev/null 2>&1
    return 0
}

bundle_stale() { # true when terminal-notifier moved on since we copied it
    local built current
    [ -d "$BUNDLE" ] || return 1
    built="$(plutil -extract POPRBuiltFrom raw "$BUNDLE/Contents/Info.plist" 2>/dev/null)"
    current="$(terminal-notifier -version 2>/dev/null | head -n 1)"
    [ -n "$current" ] && [ "$built" != "$current" ]
}

hooks_edit() { # $1 = add | remove
    local tmp additions
    has jq || { echo "popr: jq is required to edit ~/.claude/settings.json" >&2; return 1; }
    mkdir -p "$(dirname "$SETTINGS_FILE")"
    [ -f "$SETTINGS_FILE" ] || echo '{}' >"$SETTINGS_FILE"
    cp "$SETTINGS_FILE" "$SETTINGS_FILE.popr-backup"

    additions='{}'
    if [ "$1" = add ]; then
        additions="$(jq -n --arg c "\"$SCRIPT_PATH\"" '{
      Stop:             [{hooks:[{type:"command",command:($c+" stop"),   timeout:10}]}],
      Notification:     [{matcher:"permission_prompt|elicitation_dialog|elicitation_url_dialog|agent_needs_input",
                          hooks:[{type:"command",command:($c+" attention"),timeout:10}]}],
      StopFailure:      [{hooks:[{type:"command",command:($c+" error"),  timeout:10}]}],
      UserPromptSubmit: [{hooks:[{type:"command",command:($c+" clear"),  timeout:5}]}]
    }')"
    fi

    tmp="$(mktemp)"
    jq --arg pat "$HOOK_PATTERN" --argjson add "$additions" '
    .hooks = ((.hooks // {})
      | with_entries(.value |= (
          map(.hooks |= map(select(((.command // "") | test($pat)) | not)))
          | map(select((.hooks | length) > 0))))
      | with_entries(select((.value | length) > 0)))
    | .hooks = (reduce ($add | to_entries[]) as $e (.hooks; .[$e.key] = ((.[$e.key] // []) + $e.value)))
    | if (.hooks | length) == 0 then del(.hooks) else . end
  ' "$SETTINGS_FILE" >"$tmp" 2>/dev/null || { rm -f "$tmp"; echo "popr: could not parse $SETTINGS_FILE" >&2; return 1; }
    mv "$tmp" "$SETTINGS_FILE"
    return 0
}

install_cmd() {
    local force=0 quiet=0 a
    local existing
    for a in "$@"; do
        case "$a" in
            --force) force=1 ;;
            --quiet) quiet=1 ;;
        esac
    done
    [ "$(uname)" = Darwin ] || { echo "POPR only runs on macOS." >&2; exit 1; }

    if existing="$(plugin_install_found)" && [ "$force" -eq 0 ]; then
        cat >&2 <<EOF
✗ POPR is already installed as a Claude Code plugin:
    $existing

  Registering the hooks again would fire every notification twice.
  Use the plugin, or remove it and rerun. To override: popr install --force
EOF
        exit 1
    fi

    # jq is required: it parses the hook payload and edits settings.json.
    if ! has jq; then
        if has brew; then
            echo "→ installing jq"
            brew install jq
        else
            echo "✗ jq is missing and Homebrew is not installed. See https://brew.sh" >&2
            exit 1
        fi
    fi

    # terminal-notifier is optional. POPR draws its own banners, so it is only
    # needed for the native notification path, which is off by default. Install
    # it when it is easy, never fail for it.
    if ! has terminal-notifier && has brew; then
        echo "→ installing terminal-notifier (optional, for macOS notifications)"
        brew install terminal-notifier >/dev/null 2>&1 || echo "  skipped, POPR does not need it"
    fi

    # The branded bundle exists only to give macOS notifications POPR's name and
    # icon, and those are off by default. Build it when they are actually wanted,
    # not on every install.
    if is_true "$(opt native false)"; then
        if has terminal-notifier && build_bundle; then
            echo "→ built $BUNDLE, so macOS notifications carry POPR's name and icon"
        else
            echo "→ native notifications are on but the bundle could not be built" >&2
        fi
    fi

    hooks_edit add || exit 1
    echo "→ hooks registered in $SETTINGS_FILE (backup at $SETTINGS_FILE.popr-backup)"

    if [ -d "$CLAUDE_DIR/skills/butlr" ]; then
        rm -rf "$CLAUDE_DIR/skills/butlr"
        echo "→ removed the old butlr plugin"
    fi

    [ "$quiet" -eq 1 ] || "$SCRIPT_PATH" test
    [ "$quiet" -eq 1 ] && return 0
    cat <<EOF

✅ POPR installed

Next:
  1. Reload your editor window so the new hooks are picked up.
  2. popr test      to see a banner
     popr config    to change sounds and behaviour
     popr doctor    to check everything

POPR draws its own banners, so there is no notification permission to grant.

Log: $LOG_FILE
EOF
}

uninstall_cmd() {
    local d pid
    hooks_edit remove || exit 1
    echo "→ POPR hooks removed from $SETTINGS_FILE"
    for d in "$STATE_DIR"/slot-*; do
        [ -d "$d" ] || continue
        pid="$(cat "$d/pid" 2>/dev/null)"
        [ -n "$pid" ] && kill "$pid" 2>/dev/null
    done
    if [ -d "$STATE_DIR" ]; then
        rm -rf "$STATE_DIR"
        echo "→ closed any open banners and cleared $STATE_DIR"
    fi
    if [ -d "$BUNDLE" ]; then
        rm -rf "$BUNDLE"
        echo "→ removed $BUNDLE"
    fi
    echo "  The popr command itself is still installed; remove it with your package manager."
}

config_cmd() {
    local f="$CONFIG_FILE" ans
    mkdir -p "$(dirname "$f")"
    echo "POPR settings → $f"
    echo "Return keeps the shown value. Sound names: Basso Blow Bottle Frog Funk Glass"
    echo "Hero Morse Ping Pop Purr Sosumi Submarine Tink, an audio file path, or none."
    echo
    ask() { # key label default
        local d
        d="$(opt "$1" "$3")"
        printf '  %-24s [%s]: ' "$2" "$d" >&2
        read -r ans </dev/tty || ans=""
        printf '%s' "${ans:-$d}"
    }
    local done_s att_s err_s vol spk quiet app conf csize words bfont bstyle
    done_s="$(ask sound_done "Done sound" "")"
    att_s="$(ask sound_attention "Needs input sound" "")"
    err_s="$(ask sound_error "Error sound" "")"
    vol="$(ask volume "Volume 0 to 1" 1)"
    spk="$(ask speak "Say the project name" false)"
    quiet="$(ask quiet_when_focused "Quiet when app is in front" false)"
    app="$(ask app "Force target app (blank = auto)" "")"
    conf="$(ask confetti "Confetti burst" true)"
    csize="$(ask confetti_size "Confetti reach in pixels" 90)"
    words="$(ask summary_words "Words of status" 7)"
    bstyle="$(ask banner_style "Banner style (pill/glass)" pill)"
    bfont="$(ask font "Font family (blank = system)" "")"

    jq -n --arg a "$done_s" --arg b "$att_s" --arg c "$err_s" --arg v "$vol" \
        --arg s "$spk" --arg q "$quiet" --arg p "$app" --arg cf "$conf" \
        --arg cs "$csize" --arg w "$words" --arg bs "$bstyle" --arg ft "$bfont" '
    {volume:($v|tonumber? // 1),
     speak:($s|test("^(1|true|yes|on)$";"i")),
     quiet_when_focused:($q|test("^(1|true|yes|on)$";"i")),
     confetti:($cf|test("^(1|true|yes|on)$";"i")),
     confetti_size:($cs|tonumber? // 90),
     summary_words:($w|tonumber? // 7),
     banner_style:$bs}
    + (if $a == "" then {} else {sound_done:$a} end)
    + (if $b == "" then {} else {sound_attention:$b} end)
    + (if $c == "" then {} else {sound_error:$c} end)
    + (if $p == "" then {} else {app:$p} end)
    + (if $ft == "" then {} else {font:$ft} end)
  ' >"$f"
    echo
    echo "→ written to $f"
    cat "$f"
}

doctor() {
    local t existing
    echo "POPR doctor · v$VERSION"
    printf '  %-20s %s\n' "macOS" "$(sw_vers -productVersion 2>/dev/null || echo unknown)"
    for t in jq osascript afplay; do
        if has "$t"; then printf '  %-20s ok  %s\n' "$t" "$(command -v "$t")"; else printf '  %-20s MISSING\n' "$t"; fi
    done
    for t in terminal-notifier say lsappinfo; do
        if has "$t"; then printf '  %-20s ok  %s\n' "$t" "$(command -v "$t")"; else printf '  %-20s optional, absent\n' "$t"; fi
    done
    printf '  %-20s %s\n' "script" "$SCRIPT_PATH"
    printf '  %-20s %s\n' "package root" "$ROOT"
    printf '  %-20s %s\n' "host app" "$HOST_APP ($WHERE)"
    printf '  %-20s %s\n' "project" "$LABEL"
    printf '  %-20s %s\n' "click action" "$CLICK_CMD"
    if is_true "$(opt native false)" || ! is_true "$(opt banner true)"; then
        printf '  %-20s %s\n' "native picture" "${ICON:-none}"
        if [ "$BRANDED" = 1 ]; then
            printf '  %-20s %s\n' "native posts as" "POPR · $BUNDLE"
            bundle_stale && echo "  ⚠ terminal-notifier was upgraded since this bundle was built. Run: popr install"
        elif [ -n "$NOTIFIER" ]; then
            printf '  %-20s %s\n' "native posts as" "terminal-notifier (unbranded). Run: popr install"
        else
            printf '  %-20s %s\n' "native posts as" "osascript fallback, no click action"
        fi
    fi
    if [ -f "$CONFIG_FILE" ]; then
        printf '  %-20s %s\n' "config" "$CONFIG_FILE"
    else
        printf '  %-20s %s\n' "config" "none yet, run: popr config"
    fi
    if grep -qE '/bin/popr' "$SETTINGS_FILE" 2>/dev/null; then
        printf '  %-20s %s\n' "hooks" "ok, in $SETTINGS_FILE"
    else
        printf '  %-20s %s\n' "hooks" "not in settings.json (fine if installed as a plugin)"
    fi
    if existing="$(plugin_install_found)"; then
        printf '  %-20s %s\n' "plugin install" "$existing"
        grep -qE '/bin/popr' "$SETTINGS_FILE" 2>/dev/null &&
            echo "  ⚠ DOUBLE REGISTRATION: both a plugin and settings.json hooks. Run: popr uninstall"
    fi
    if grep -qE '/bin/butlr' "$SETTINGS_FILE" 2>/dev/null; then
        echo "  ⚠ leftover butlr hooks found. Run: popr install"
    fi
    if ! is_true "$(opt confetti true)"; then
        printf '  %-20s %s\n' "confetti" "off"
    elif [ -f "$BANNER_JS" ]; then
        printf '  %-20s %s\n' "confetti" "on, reaching $(opt confetti_size 90)px, seeded from $PROJECT_NAME"
    else
        printf '  %-20s %s\n' "confetti" "on, but $BANNER_JS is missing"
    fi
    if is_true "$(opt banner true)" && [ -f "$BANNER_JS" ]; then
        printf '  %-20s %s\n' "banners" "POPR's own, style $(opt banner_style pill)"
    else
        printf '  %-20s %s\n' "banners" "macOS notifications"
    fi
    if is_true "$(opt native false)"; then
        printf '  %-20s %s\n' "native notif" "also posting to Notification Center"
    fi
    printf '  %-20s %s\n' "log" "$LOG_FILE"
    has jq || echo "  fix: brew install jq"
    if is_true "$(opt banner true)"; then
        echo "  No banner? Check osascript above, then: popr test"
        echo "  Banners are POPR's own windows: no notification permission, and"
        echo "  Focus and Do Not Disturb do not silence them either."
    else
        echo "  Banners are off, so this posts macOS notifications instead."
        echo "  No banner? System Settings › Notifications › POPR: allow, style Alerts."
        echo "  Focus modes silence those."
    fi
}

usage() {
    cat <<EOF
POPR v$VERSION · clickable macOS notifications for Claude Code

  popr install [--force] [--quiet]
                          register hooks in ~/.claude/settings.json
  popr uninstall          remove them
  popr config             interactive settings
  popr test               fire a test notification
  popr doctor             health check
  popr version

Settings (POPR_<KEY> env > plugin option > $CONFIG_FILE > default):
  sound_done          bundled   POPR's own hum. Or a macOS sound name
                                (Glass, Hero, Ping...), an audio file, or none
  sound_attention     bundled
  sound_error         bundled
  volume              1         0 to 1
  speak               false     also say the project name
  quiet_when_focused  false     skip when the target app is already in front
  app                 auto      force the target app, e.g. Cursor
  icon                none      picture on the RIGHT: a PNG path, "app" for the
                                host app's icon, or none. The logo on the LEFT
                                is the bundle's icon and cannot be changed here.
  banner              true      draw POPR's own banner instead of a macOS one
  banner_style        pill      pill (ivory) or glass (blurred dark)
  banner_icon         auto      a PNG to use instead of the project's own mark
  banner_seconds      900       backstop before a banner gives up waiting
  native              false     also post a macOS notification
  font                system    a font family name, e.g. "Styrene A"
  confetti            true      the burst out of the banner's logo when a turn ends
  confetti_size       90        how far it reaches, in pixels
  summary_words       7         how many words of status the banner shows
EOF
}

# ---------------------------------------------------------------- dispatch
case "$MODE" in
    version | --version | -v) echo "$VERSION"; exit 0 ;;
    help | --help | -h) usage; exit 0 ;;
    doctor) doctor; exit 0 ;;
    install) install_cmd "$@"; exit 0 ;;
    uninstall) uninstall_cmd; exit 0 ;;
    config) config_cmd; exit 0 ;;
    test)
        play_sound "$(opt sound_done "$(snd pop Glass)")"
        burst_arm
        notify "✓ $LABEL" "POPR test" "Click the banner to bring $WHERE to the front"
        speak "POPR test for $PROJECT_NAME"
        log "test fired for $LABEL in $WHERE"
        echo "Banner shown for $LABEL. Clicking it runs: $CLICK_CMD"
        exit 0
        ;;
    clear)
        drop_session_banner
        [ -n "$NOTIFIER" ] && ("$NOTIFIER" -remove "$GROUP" >/dev/null 2>&1 &)
        exit 0
        ;;
    stop | attention | error) ;;
    *) echo "popr: unknown command '$MODE'. Try: popr help" >&2; exit 0 ;;
esac

log "hook fired: $MODE, $LABEL in $WHERE (entry: ${ENTRY:-none})"
if is_true "$(opt quiet_when_focused false)" && is_focused; then
    log "skipped, $WHERE is frontmost ($LABEL)"
    exit 0
fi

# Everything slow happens detached, so Claude never waits on POPR.
run() {
    case "$MODE" in
        stop)
            [ -n "$DRY" ] || sleep 0.4
            msg="$(summary)"
            [ -n "$msg" ] || msg="Ready for your next prompt"
            play_sound "$(opt sound_done "$(snd pop Glass)")"
            burst_arm
            notify "✓ $LABEL" "Done in $WHERE" "$msg"
            speak "$PROJECT_NAME is done"
            ;;
        attention)
            msg="$(clean "$(jget '.message')")"
            [ -n "$msg" ] || msg="Claude is waiting for you"
            play_sound "$(opt sound_attention "$(snd ask Ping)")"
            notify "⋯ $LABEL" "Needs you in $WHERE" "$msg"
            speak "$PROJECT_NAME needs you"
            ;;
        error)
            err="$(clean "$(jget '.error_type // .error // .reason')")"
            play_sound "$(opt sound_error "$(snd err Basso)")"
            notify "✕ $LABEL" "Stopped in $WHERE" "Claude hit an error${err:+: $err}"
            speak "$PROJECT_NAME hit an error"
            ;;
    esac
    log "$LABEL in $WHERE"
}

if [ -n "$DRY" ]; then
    run # foreground, so tests can read stdout
else
    (run) </dev/null >/dev/null 2>&1 &
fi
exit 0
